# Generic Vite web app Dockerfile — used by staff-web and admin-web

# ── Stage 1: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

ARG VITE_API_URL=http://localhost:3001/api/v1
ENV VITE_API_URL=$VITE_API_URL

WORKDIR /app

# Copy workspace root
COPY package.json package-lock.json* ./
COPY tsconfig.base.json ./

# Copy shared packages
COPY packages/design-tokens ./packages/design-tokens
COPY packages/shared-types  ./packages/shared-types
COPY packages/validation    ./packages/validation
COPY packages/config        ./packages/config
COPY packages/api-client    ./packages/api-client
COPY packages/ui-web        ./packages/ui-web

# The specific web app directory is the build context, copied as-is
COPY . ./app-src

RUN npm ci --include-workspace-root

WORKDIR /app/app-src
RUN npm run build

# ── Stage 2: Nginx serving ────────────────────────────────────────────────────
FROM nginx:alpine AS runner

COPY --from=builder /app/app-src/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
