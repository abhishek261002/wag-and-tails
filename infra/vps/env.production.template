# Production settings for the API. The setup script fills the __WORDS__ for you.
# The API reads ONLY this file (apps/api/.env). Never commit it, never paste it in chats.

NODE_ENV=production
API_PORT=3001
TRUST_PROXY=true
API_URL=https://__DOMAIN__
PUBLIC_API_URL=https://__DOMAIN__

DATABASE_URL=postgresql://wag:__DB_PASS__@127.0.0.1:5432/wagandtails
REDIS_URL=redis://127.0.0.1:6379

JWT_SECRET=__JWT_SECRET__
JWT_REFRESH_SECRET=__JWT_REFRESH_SECRET__
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# No admin web or staff web any more: the website's plugin is the only panel. The phone apps do not need CORS.
CORS_ORIGINS=

# Uploaded photos/documents live here (backed up by backup.sh)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/opt/wag/uploads
# Aadhaar card photos: encrypted files in a folder the web server never serves.
STORAGE_PRIVATE_PATH=/opt/wag/private-uploads

# ---- Switches to review BEFORE real customers use the apps (see README "Before real customers") ----
# The API refuses to start in production with mock payments or mock KYC unless these two lines allow it.
# They are here so the first deploy and your own testing work. They accept ANY payment / ANY KYC, so remove
# them as soon as the real providers are set up (then set PAYMENT_PROVIDER=razorpay and add the Razorpay keys).
PAYMENT_PROVIDER=mock
PAYMENT_ALLOW_MOCK=true
KYC_PROVIDER=mock
KYC_ALLOW_MOCK=true
# SMS: the code has no real SMS sender yet. "mock" returns the login code inside the API answer, which is
# only fine for testing. Real customers need a real sender built first.
SMS_PROVIDER=mock
PUSH_PROVIDER=expo
EMAIL_PROVIDER=mock
MAPS_PROVIDER=ola
ROUTING_PROVIDER=osrm
LLM_PROVIDER=mock
# OLA_MAPS_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# GEMINI_API_KEY=

# Never change these after real users exist, and keep a copy of both in a password manager:
#  - the pepper protects the stored identity hashes;
#  - the encryption key locks the Aadhaar numbers and card photos. Lose it and they can never be read again;
#    leak it together with a backup and they can be read by whoever has both.
AADHAAR_HASH_PEPPER=__PEPPER__
AADHAAR_ENC_KEY=__AADHAAR_KEY__

# ---- Website link (leave these two commented until the plugin is installed: see DATA-SAFETY.md and README step 9) ----
# WP_CONNECTOR_URL=https://wagandtails.in/wp-json
# WP_CONNECTOR_SECRET=
