# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres?schema=public
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=wag-and-tails-local-dev-secret-key-32ch
JWT_REFRESH_SECRET=wag-and-tails-refresh-secret-key-32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=wagandtails-dev
STORAGE_LOCAL_PATH=./uploads

# Payments
PAYMENT_PROVIDER=mock
# The mock accepts any payment and is refused when NODE_ENV=production. Real payments need razorpay + both keys below.
# DIRECT_REQUEST_TTL_MINUTES=10   # how long a chosen partner has to answer before the customer picks again
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Maps
MAPS_PROVIDER=mock
# Turn-by-turn routing: ola (needs OLA_MAPS_API_KEY) | osrm (free public server, fine for development) | mock (straight-line estimates)
ROUTING_PROVIDER=osrm
OLA_MAPS_API_KEY=
# OSRM_URL=https://router.project-osrm.org   # point at your own OSRM server in production
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# Push Notifications
PUSH_PROVIDER=mock   # mock | expo (expo sends real pushes through Expo)
# EXPO_ACCESS_TOKEN=          # optional, from expo.dev, if push security is enabled
# SCHEDULER_ENABLED=true      # daily reminders and 5-minute jobs; set false on extra API instances if you prefer
FCM_SERVER_KEY=

# LLM
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
FROM_EMAIL=hello@wagandtails.in

# App
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
CUSTOMER_APP_URL=http://localhost:3002
STAFF_APP_URL=http://localhost:3003
ADMIN_APP_URL=http://localhost:3004
CORS_ORIGINS=http://localhost:3002,http://localhost:3003,http://localhost:3004

DB_PASS  = wag-and-tails
PROJECT_NAME = wag-and-tails
# KYC (mock = dev only; set a real provider + a long random pepper in production, never rotate the pepper)
KYC_PROVIDER=mock
AADHAAR_HASH_PEPPER=
# DigiLocker (KYC_PROVIDER=digilocker): requester credentials + the callback URL whitelisted with DigiLocker
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://YOUR-API-HOST/api/v1/auth/partner/digilocker/callback
# Deep link DigiLocker returns to (must match the partner app scheme)
KYC_APP_REDIRECT=wagandtailspartner://kyc
