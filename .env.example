# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wagandtails
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP / SMS
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Storage
STORAGE_PROVIDER=local
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=wagandtails-dev
STORAGE_LOCAL_PATH=./uploads

# Payments
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Maps
MAPS_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_TOKEN=

# Push Notifications
PUSH_PROVIDER=mock
FCM_SERVER_KEY=

# LLM
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Email
EMAIL_PROVIDER=mock
SENDGRID_API_KEY=
FROM_EMAIL=hello@wagandtails.in

# App
NODE_ENV=development
API_PORT=3001
API_URL=http://localhost:3001
CUSTOMER_APP_URL=http://localhost:3002
STAFF_APP_URL=http://localhost:3003
ADMIN_APP_URL=http://localhost:3004
CORS_ORIGINS=http://localhost:3002,http://localhost:3003,http://localhost:3004
