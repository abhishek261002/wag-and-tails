{
  "expo": {
    "name": "Wag & Tails",
    "slug": "wag-and-tails-customer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "in.wagandtails.customer",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We use your location to find nearby partners and track your pet's walk.",
        "NSPhotoLibraryUsageDescription": "Upload photos of your pet.",
        "NSCameraUsageDescription": "Take photos for your pet's profile.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A1E0B"
      },
      "package": "in.wagandtails.customer",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Wag & Tails to use your location."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4A1E0B"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "scheme": "wagandtails",
    "extra": {
      "apiUrl": "http://localhost:3001/api/v1",
      "router": {},
      "eas": {
        "projectId": "7230b194-83fe-46f1-9550-9aaf695c08e0"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}